<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#00BCD4"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:orientation="vertical"
        android:background="@color/red"
        android:gravity="center_horizontal"
        android:paddingTop="32dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verification"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#fff"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="We have sent a code to your email\nexample@gmail.com"
            android:textColor="#fff"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- OTP Input -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="-40dp"
        android:layout_marginBottom="16dp">

        <!-- 6 EditText for OTP -->
        <EditText android:id="@+id/etCode1"
            android:layout_width="48dp" android:layout_height="56dp" android:layout_marginHorizontal="4dp"
            android:textSize="20sp" android:inputType="number" android:maxLength="1"
            android:textColor="#22223B" android:gravity="center" android:background="@android:color/white" />
        <EditText android:id="@+id/etCode2"
            android:layout_width="48dp" android:layout_height="56dp" android:layout_marginHorizontal="4dp"
            android:textSize="20sp" android:inputType="number" android:maxLength="1"
            android:textColor="#22223B" android:gravity="center" android:background="@android:color/white" />
        <EditText android:id="@+id/etCode3"
            android:layout_width="48dp" android:layout_height="56dp" android:layout_marginHorizontal="4dp"
            android:textSize="20sp" android:inputType="number" android:maxLength="1"
            android:textColor="#22223B" android:gravity="center" android:background="@android:color/white" />
        <EditText android:id="@+id/etCode4"
            android:layout_width="48dp" android:layout_height="56dp" android:layout_marginHorizontal="4dp"
            android:textSize="20sp" android:inputType="number" android:maxLength="1"
            android:textColor="#22223B" android:gravity="center" android:background="@android:color/white" />
        <EditText android:id="@+id/etCode5"
            android:layout_width="48dp" android:layout_height="56dp" android:layout_marginHorizontal="4dp"
            android:textSize="20sp" android:inputType="number" android:maxLength="1"
            android:textColor="#22223B" android:gravity="center" android:background="@android:color/white" />
        <EditText android:id="@+id/etCode6"
            android:layout_width="48dp" android:layout_height="56dp" android:layout_marginHorizontal="4dp"
            android:textSize="20sp" android:inputType="number" android:maxLength="1"
            android:textColor="#22223B" android:gravity="center" android:background="@android:color/white" />
    </LinearLayout>

    <!-- Resend -->
    <TextView
        android:id="@+id/tvResend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resend in 50 sec"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <!-- Verify Button -->
    <Button
        android:id="@+id/btnVerify"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="VERIFY"
        android:textAllCaps="true"
        android:textColor="#fff"
        android:backgroundTint="@color/red"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="8dp"
        android:textStyle="bold" />

</LinearLayout> 